{
  "document_id": "sample1_eligibility",
  "section": "5.1",
  "section_title": "ELIGIBILITY CRITERIA",
  "rules": [
    {
      "rule_id": "5.1.a",
      "section": "5.1",
      "subsection": "a",
      "source_text": "Each applicant must have a credit score of at least 680.",
      "confidence": "high",
      "unmapped_attributes": [],
      "body": {
        "scope": "per_entity",
        "entity": "applicant",
        "must_satisfy": {
          "op": "gte",
          "attr": "applicant.credit_score",
          "value": 680,
          "unmapped": false,
          "original_phrase": null
        },
        "evaluation_context": null
      }
    },
    {
      "rule_id": "5.1.b",
      "section": "5.1",
      "subsection": "b",
      "source_text": "The maximum coverage amount for any single policy shall not exceed $2,000,000.",
      "confidence": "high",
      "unmapped_attributes": [],
      "body": {
        "scope": "per_entity",
        "entity": "policy",
        "must_satisfy": {
          "op": "lte",
          "attr": "policy.coverage_amount_usd",
          "value": 2000000,
          "unmapped": false,
          "original_phrase": null
        },
        "evaluation_context": null
      }
    },
    {
      "rule_id": "5.1.c.1",
      "section": "5.1",
      "subsection": "c",
      "source_text": "The applicant must have a credit score of at least 680, provided that no more than 15% of the total portfolio value may consist of policies for applicants with credit scores between 680 and 700.",
      "confidence": "high",
      "unmapped_attributes": [],
      "body": {
        "scope": "per_entity",
        "entity": "applicant",
        "must_satisfy": {
          "op": "gte",
          "attr": "applicant.credit_score",
          "value": 680,
          "unmapped": false,
          "original_phrase": null
        },
        "evaluation_context": null
      }
    },
    {
      "rule_id": "5.1.c.2",
      "section": "5.1",
      "subsection": "c",
      "source_text": "The applicant must have a credit score of at least 680, provided that no more than 15% of the total portfolio value may consist of policies for applicants with credit scores between 680 and 700.",
      "confidence": "high",
      "unmapped_attributes": [],
      "body": {
        "scope": "portfolio_subset_share",
        "subset": {
          "op": "between",
          "attr": "applicant.credit_score",
          "value": [
            680,
            700
          ],
          "unmapped": false,
          "original_phrase": null
        },
        "subset_groupby": null,
        "share_of": "total_portfolio_value_usd",
        "share_constraint": {
          "op": "lte",
          "value": 15.0,
          "unit": "percent"
        }
      }
    },
    {
      "rule_id": "5.1.d",
      "section": "5.1",
      "subsection": "d",
      "source_text": "The debt-to-income ratio shall not exceed 40%, or 45% if the applicant has a co-signer with a credit score above 750.",
      "confidence": "high",
      "unmapped_attributes": [],
      "body": {
        "scope": "per_entity",
        "entity": "applicant",
        "must_satisfy": {
          "op": "or",
          "args": [
            {
              "op": "lte",
              "attr": "applicant.debt_to_income_ratio_pct",
              "value": 40,
              "unmapped": false,
              "original_phrase": null
            },
            {
              "op": "and",
              "args": [
                {
                  "op": "gt",
                  "attr": "applicant.cosigner.credit_score",
                  "value": 750,
                  "unmapped": false,
                  "original_phrase": null
                },
                {
                  "op": "lte",
                  "attr": "applicant.debt_to_income_ratio_pct",
                  "value": 45,
                  "unmapped": false,
                  "original_phrase": null
                }
              ]
            }
          ]
        },
        "evaluation_context": null
      }
    },
    {
      "rule_id": "5.1.e",
      "section": "5.1",
      "subsection": "e",
      "source_text": "The applicant must not have any payment more than 30 days overdue as of the Review Date.",
      "confidence": "high",
      "unmapped_attributes": [],
      "body": {
        "scope": "per_entity",
        "entity": "applicant",
        "must_satisfy": {
          "op": "lte",
          "attr": "applicant.payment_overdue_days_max",
          "value": 30,
          "unmapped": false,
          "original_phrase": null
        },
        "evaluation_context": {
          "as_of": "review_date"
        }
      }
    },
    {
      "rule_id": "5.1.f",
      "section": "5.1",
      "subsection": "f",
      "source_text": "The applicant must reside in the United States or its territories.",
      "confidence": "high",
      "unmapped_attributes": [],
      "body": {
        "scope": "per_entity",
        "entity": "applicant",
        "must_satisfy": {
          "op": "in",
          "attr": "applicant.country_of_residence",
          "value": [
            "US",
            "US_TERRITORY"
          ],
          "unmapped": false,
          "original_phrase": null
        },
        "evaluation_context": null
      }
    },
    {
      "rule_id": "5.1.g",
      "section": "5.1",
      "subsection": "g",
      "source_text": "No applicant shall have an annual income below $35,000, unless the applicant is enrolled in an approved assistance program, in which case the minimum income shall be $25,000.",
      "confidence": "high",
      "unmapped_attributes": [],
      "body": {
        "scope": "per_entity",
        "entity": "applicant",
        "must_satisfy": {
          "op": "or",
          "args": [
            {
              "op": "gte",
              "attr": "applicant.annual_income_usd",
              "value": 35000,
              "unmapped": false,
              "original_phrase": null
            },
            {
              "op": "and",
              "args": [
                {
                  "op": "eq",
                  "attr": "applicant.enrolled_in_approved_assistance_program",
                  "value": true,
                  "unmapped": false,
                  "original_phrase": null
                },
                {
                  "op": "gte",
                  "attr": "applicant.annual_income_usd",
                  "value": 25000,
                  "unmapped": false,
                  "original_phrase": null
                }
              ]
            }
          ]
        },
        "evaluation_context": null
      }
    }
  ]
}