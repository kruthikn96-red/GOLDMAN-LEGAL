# Copy this file to `.env` and fill in ONE of the following keys.
# OpenAI is the recommended default for this pipeline (most reliable
# structured-output support for the recursive predicate-tree schema).

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: override the default provider. Default is "anthropic" if unset
# and ANTHROPIC_API_KEY is present; otherwise pass --provider on the CLI.
# Valid values: anthropic | openai | google
LLM_PROVIDER=openai
